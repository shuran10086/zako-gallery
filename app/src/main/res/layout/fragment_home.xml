<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- centered brand header, per the reference design -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_l">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_round">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/app_name"
                android:textColor="@color/pink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/home_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <View
                android:layout_width="@dimen/accent_line_width"
                android:layout_height="@dimen/accent_line_height"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_accent_bar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <!-- wallpaper card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/section_icon"
                            android:layout_height="@dimen/section_icon"
                            android:contentDescription="@string/wallpaper_switch"
                            android:src="@drawable/ic_section_wallpaper" />

                        <TextView
                            style="@style/TextAppearance.RandomWallpaper.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:text="@string/wallpaper_switch" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_wallpaper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/label_wallpaper_interval_range"
                        style="@style/TextAppearance.RandomWallpaper.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/range_wallpaper_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:stepSize="1"
                        app:thumbColor="@color/pink"
                        app:trackColorActive="@color/pink"
                        app:trackColorInactive="@color/divider"
                        android:valueFrom="1"
                        android:valueTo="60" />

                    <TextView
                        android:id="@+id/tv_wallpaper_gallery"
                        style="@style/TextAppearance.RandomWallpaper.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_lockscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/lockscreen_switch"
                        android:textAppearance="@style/TextAppearance.RandomWallpaper.Body"
                        android:textColor="@color/text_primary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- popup card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/section_icon"
                            android:layout_height="@dimen/section_icon"
                            android:contentDescription="@string/popup_switch"
                            android:src="@drawable/ic_section_popup" />

                        <TextView
                            style="@style/TextAppearance.RandomWallpaper.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:text="@string/popup_switch" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_popup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/label_popup_desc"
                        style="@style/TextAppearance.RandomWallpaper.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/popup_desc" />

                    <TextView
                        android:id="@+id/label_popup_interval_range"
                        style="@style/TextAppearance.RandomWallpaper.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/range_popup_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:stepSize="1"
                        app:thumbColor="@color/pink"
                        app:trackColorActive="@color/pink"
                        app:trackColorInactive="@color/divider"
                        android:valueFrom="1"
                        android:valueTo="60" />

                    <TextView
                        android:id="@+id/label_popup_duration_range"
                        style="@style/TextAppearance.RandomWallpaper.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/range_popup_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:stepSize="1"
                        app:thumbColor="@color/pink"
                        app:trackColorActive="@color/pink"
                        app:trackColorInactive="@color/divider"
                        android:valueFrom="3"
                        android:valueTo="60" />

                    <TextView
                        android:id="@+id/tv_popup_gallery"
                        style="@style/TextAppearance.RandomWallpaper.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- shown instead of the function cards while 锁定主页 is engaged -->
        <LinearLayout
            android:id="@+id/lock_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock" />

            <TextView
                style="@style/TextAppearance.RandomWallpaper.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/home_locked_notice" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
