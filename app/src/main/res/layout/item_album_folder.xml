<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="@dimen/corner_item"
    app:cardElevation="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_cover"
            android:layout_width="match_parent"
            android:layout_height="@dimen/album_cover_height"
            android:contentDescription="@string/cd_album_cover"
            android:scaleType="centerCrop" />

        <!-- bottom bar with the album name and image count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_s">

            <TextView
                android:id="@+id/tv_name"
                style="@style/TextAppearance.RandomWallpaper.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_count"
                style="@style/TextAppearance.RandomWallpaper.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s" />
        </LinearLayout>

        <!-- badge on the synthetic "recent" album -->
        <TextView
            android:id="@+id/tv_badge"
            style="@style/TextAppearance.RandomWallpaper.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_s"
            android:background="@drawable/bg_badge_circle"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="2dp"
            android:text="@string/album_recent"
            android:textColor="@color/white"
            android:visibility="gone" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
