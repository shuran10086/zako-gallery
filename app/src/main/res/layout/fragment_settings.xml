<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- gallery selection -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/section_icon"
                        android:layout_height="@dimen/section_icon"
                        android:contentDescription="@string/settings_gallery_title"
                        android:src="@drawable/ic_folder" />

                    <TextView
                        style="@style/TextAppearance.RandomWallpaper.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/settings_gallery_title" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.RandomWallpaper.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/settings_wallpaper_gallery" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinner_wallpaper_gallery"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_closed"
                        android:popupBackground="@drawable/bg_spinner_popup"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@string/settings_gallery_title"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.RandomWallpaper.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/settings_popup_gallery" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinner_popup_gallery"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_closed"
                        android:popupBackground="@drawable/bg_spinner_popup"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@string/settings_gallery_title"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.RandomWallpaper.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/settings_gallery_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- management entries -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/TextAppearance.RandomWallpaper.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_manage_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gallery_manage"
                    style="@style/Widget.RandomWallpaper.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/btn_gallery_manage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_permissions"
                    style="@style/Widget.RandomWallpaper.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/btn_permissions" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- about -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_xl"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/TextAppearance.RandomWallpaper.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_about_title" />

                <TextView
                    android:id="@+id/tv_version"
                    style="@style/TextAppearance.RandomWallpaper.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <TextView
                    style="@style/TextAppearance.RandomWallpaper.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/settings_about_desc" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
